# Copy this file to lib/.env and fill in your Firebase app configuration.
# Client-side Firebase configuration is bundled into the application; it is
# not a place for passwords, service-account keys, or other secrets.
FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_MESSAGING_SENDER_ID
FIREBASE_PROJECT_ID=REPLACE_WITH_PROJECT_ID
FIREBASE_STORAGE_BUCKET=REPLACE_WITH_STORAGE_BUCKET

WEB_API_KEY=REPLACE_WITH_WEB_API_KEY
WEB_APP_ID=REPLACE_WITH_WEB_APP_ID
WEB_AUTH_DOMAIN=REPLACE_WITH_WEB_AUTH_DOMAIN

ANDROID_API_KEY=REPLACE_WITH_ANDROID_API_KEY
ANDROID_APP_ID=REPLACE_WITH_ANDROID_APP_ID

IOS_API_KEY=REPLACE_WITH_IOS_API_KEY
IOS_APP_ID=REPLACE_WITH_IOS_APP_ID
IOS_BUNDLE_ID=REPLACE_WITH_IOS_BUNDLE_ID

WINDOWS_API_KEY=REPLACE_WITH_WINDOWS_API_KEY
WINDOWS_APP_ID=REPLACE_WITH_WINDOWS_APP_ID
WINDOWS_AUTH_DOMAIN=REPLACE_WITH_WINDOWS_AUTH_DOMAIN
